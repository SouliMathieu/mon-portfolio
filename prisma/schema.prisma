generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Project {
  id            Int             @id @default(autoincrement())
  slug          String          @unique
  titleFr       String
  titleEn       String
  categoryFr    String
  categoryEn    String
  descriptionFr String          @db.Text
  descriptionEn String          @db.Text
  demoUrl       String?
  codeUrl       String?
  featured      Boolean         @default(false)
  order         Int             @default(0)
  images        ProjectImage[]
  technologies  Technology[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model ProjectImage {
  id        Int     @id @default(autoincrement())
  url       String
  altFr     String?
  altEn     String?
  order     Int     @default(0)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId Int
}

model SkillBlock {
  id            Int          @id @default(autoincrement())
  slug          String       @unique
  titleFr       String
  titleEn       String
  descriptionFr String       @db.Text
  descriptionEn String       @db.Text
  order         Int          @default(0)
  technologies  Technology[]
  
}

model Technology {
  id           Int         @id @default(autoincrement())
  name         String
  level        Int         @default(3)
  skillBlock   SkillBlock  @relation(fields: [skillBlockId], references: [id], onDelete: Cascade)
  skillBlockId Int
  projects     Project[]
  
  @@unique([name, skillBlockId])
}

model AboutContent {
  id           Int      @id @default(autoincrement())
  bioFr        String   @db.Text
  bioEn        String   @db.Text
  highlightsFr Json
  highlightsEn Json
  email        String
  phone        String
  linkedin     String
  github       String
  location     String
  photoUrl     String?
  updatedAt    DateTime @updatedAt
  titleFr       String   @default("")
  titleEn       String   @default("")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Admin {
  id       Int    @id @default(autoincrement())
  email    String @unique
  password String
}
model Certification {
  id      Int      @id @default(autoincrement())
  titleFr String
  titleEn String
  issuer  String
  date    DateTime
  url     String?
  fileUrl String?
  order   Int      @default(0)
}
model Service {
  id            Int    @id @default(autoincrement())
  titleFr       String
  titleEn       String
  descriptionFr String @db.Text
  descriptionEn String @db.Text
  order         Int    @default(0)
}